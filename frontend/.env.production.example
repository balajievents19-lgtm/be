# Nuxt public runtime (baked at build time for NUXT_PUBLIC_*)
NUXT_PUBLIC_API_BASE=https://www.balajiroyalevents.com/api

# Node SSR process
HOST=127.0.0.1
PORT=3000
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
NODE_ENV=production

# Server-only (NOT NUXT_PUBLIC_*). Must match backend SSR_INTERNAL_SECRET.
# Nuxt maps NUXT_SSR_INTERNAL_SECRET to runtimeConfig.ssrInternalSecret
NUXT_SSR_INTERNAL_SECRET=

# Customer OAuth secrets belong on Laravel only — never NUXT_PUBLIC_*.

# Production checklist (Laravel side — not Nuxt):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://www.balajiroyalevents.com  (Laravel origin; API is /api on the same host)
# SITE_URL / FRONTEND_URL = https://www.balajiroyalevents.com
# NUXT_PUBLIC_API_BASE=https://www.balajiroyalevents.com/api (set at Nuxt build time)
# SESSION_* + SANCTUM_STATEFUL_DOMAINS + CORS_ALLOWED_ORIGINS

# SSR_INTERNAL_SECRET matches NUXT_SSR_INTERNAL_SECRET
# GOOGLE_* / FACEBOOK_* for Socialite
# MAIL_* for real password-reset delivery

