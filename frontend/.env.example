# Nuxt public runtime — local defaults
# Copy to .env and override as needed.
# Production: see .env.production.example

# Same-origin API through the Nuxt dev proxy (see nuxt.config.ts).
# Override with an absolute Laravel URL only if you skip the proxy.
NUXT_PUBLIC_API_BASE=/api

# Server-only (not sent to the browser). Production SSR → Laravel loopback:
# NUXT_API_INTERNAL_BASE=http://127.0.0.1:8000/api
NUXT_API_INTERNAL_BASE=http://127.0.0.1:8000/api

# Dev proxy target for /api, /storage, /sanctum (nuxt.config.ts only).
NUXT_DEV_LARAVEL_ORIGIN=http://127.0.0.1:8000

# Server-only (NOT NUXT_PUBLIC_*). Must match backend SSR_INTERNAL_SECRET.
# Nuxt maps NUXT_SSR_INTERNAL_SECRET to runtimeConfig.ssrInternalSecret
NUXT_SSR_INTERNAL_SECRET=

# Customer auth uses HttpOnly session cookies against the Laravel origin.
# Do NOT put Google/Facebook client secrets or GOOGLE_PLACES_API_KEY in Nuxt env.
