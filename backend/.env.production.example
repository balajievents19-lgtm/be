APP_NAME="Balaji Events"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=balaji_events
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=balaji_

# Optional Redis (set CACHE_STORE=redis and QUEUE_CONNECTION=redis when ready)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Public website origin (Nuxt) — REQUIRED. Replace example.com with your real public host.
# Used for canonicals, Open Graph, JSON-LD, and sitemap <loc>. NOT the API host (APP_URL).
# Precedence: SITE_URL → FRONTEND_URL → Admin canonical_url → APP_URL.
# After deploy/change: php artisan config:clear && php artisan cache:clear && php artisan optimize
SITE_URL=https://www.example.com
FRONTEND_URL=https://www.example.com

# Comma-separated Filament admin emails (required in production)
ADMIN_EMAILS=admin@example.com

SEO_SITEMAP_CACHE_TTL=3600
SEO_SCHEMA_CACHE_TTL=3600

# Trusted Nuxt SSR ? Laravel read APIs (X-SSR-Secret). Empty = public limiter only.
# Generate a long random value in production. Never commit real secrets.
SSR_INTERNAL_SECRET=
# Finite per-minute limit for trusted SSR GET/HEAD (default 300).
# SSR_INTERNAL_RATE_LIMIT=300
