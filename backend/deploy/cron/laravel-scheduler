# Balaji Events — Laravel scheduler
# Install:
#   sudo cp deploy/cron/laravel-scheduler /etc/cron.d/balaji-events-scheduler
#   sudo chmod 644 /etc/cron.d/balaji-events-scheduler
#
# Or add to www-data crontab:
#   * * * * * cd /var/www/balaji-events/backend && php artisan schedule:run >> /dev/null 2>&1

* * * * * www-data cd /var/www/balaji-events/backend && php artisan schedule:run >> /dev/null 2>&1
