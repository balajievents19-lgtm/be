APP_NAME="Balaji Events"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Public frontend origin (Nuxt) — REQUIRED for correct SEO hosts.
# Used for canonicals, Open Graph, JSON-LD, and sitemap <loc> entries.
# Do NOT set this to the Laravel/API host. Sitemap.xml / robots.txt are still served from APP_URL.
# Precedence: SITE_URL → FRONTEND_URL → Admin canonical_url → APP_URL.
# After changing: php artisan config:clear && php artisan cache:clear && php artisan optimize
SITE_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:3000

# Comma-separated emails allowed into Filament. Required in production; empty = non-production only.
ADMIN_EMAILS=

# See .env.production.example for a production-oriented template.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=balaji_events
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEO cache TTLs (seconds)
SEO_SITEMAP_CACHE_TTL=3600
SEO_SCHEMA_CACHE_TTL=3600

# Trusted Nuxt SSR ? Laravel read APIs (X-SSR-Secret). Empty = public limiter only.
# Generate a long random value in production. Never commit real secrets.
SSR_INTERNAL_SECRET=
# Finite per-minute limit for trusted SSR GET/HEAD (default 300).
# SSR_INTERNAL_RATE_LIMIT=300
